# 1. 数据库配置 (Database)
MYSQL_ROOT_PASSWORD=
# Spring数据源连接URL
MYSQL_DATASOURCE_URL=
# Spring数据源用户名（绝对不能填 root！MySQL 容器初始化时会用它创建单独的应用账号，建议填 washy_user）
MYSQL_DATASOURCE_USERNAME=
# Spring数据源密码（对应上面应用账号的密码）
MYSQL_DATASOURCE_PASSWORD=


# 2. 邮件服务
MAIL_HOST=
# 邮件服务器端口，常见：25 / 465 / 587
MAIL_PORT=
# 邮箱地址（发件人完整邮箱）
MAIL_USERNAME=
# 邮箱授权码或密码（注意：通常不是邮箱登录密码，而是开启 SMTP 后获取的授权码）
MAIL_PASSWORD=


# 3. 认证与安全 (Auth & Security)
# Token 签名密钥，建议使用足够长的随机字符串（32 位以上）
# 可用命令生成：openssl rand -base64 48
AUTH_TOKEN_SECRET=
# 允许跨域的前端来源，多个用逗号分隔（同源部署时，留空或填入真实域名）
# 示例：https://washy.example.com,http://localhost:3000
APP_CORS_ALLOWED_ORIGINS=


# 4. 外部服务 (External Services)
# DeepSeek API Key
DEEPSEEK_API_KEY=


# 5. 前端构建参数 (Frontend Build)
# 前端请求后端的 API 基础地址
# 同源部署（Nginx 把 /api/ 代理到后端）时填 /api，这是本项目的默认拓扑。
# 注意：留空会覆盖 .env.production 里的 /api，导致请求缺少 /api 前缀。
# 示例：/api 或 https://washy.example.com/api
APP_API_BASE_URL=/api


# 编写好后，复制此文件为 .env 并填入真实值。
# 在项目根目录下启动：
# docker compose up --build -d
#
# 停止并清理容器：
# docker compose down
