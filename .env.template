# 数据库
# MySQL root用户密码
MYSQL_ROOT_PASSWORD=
# Spring数据源连接URL
# 示例：jdbc:mysql://mysql:3306/washy_db
MYSQL_DATASOURCE_URL=
# Spring数据源用户名（不要用 root：MySQL 容器初始化时会用它创建单独的应用账号）
MYSQL_DATASOURCE_USERNAME=
# Spring数据源密码
MYSQL_DATASOURCE_PASSWORD=


# 邮件服务
# 邮件服务器地址，例如smtp.qq.com/smtp.163.com
MAIL_HOST=
# 邮件服务器端口，常见：25/465/587
MAIL_PORT=
# 邮箱地址
MAIL_USERNAME=
# 邮箱授权码或密码
MAIL_PASSWORD=


# 认证与安全
# Token 签名密钥，建议使用足够长的随机字符串（32 位以上）
# 可用命令生成：openssl rand -base64 48
AUTH_TOKEN_SECRET=
# 允许跨域的前端来源，多个用逗号分隔
# 示例：https://washy.example.com,http://localhost:3000
APP_CORS_ALLOWED_ORIGINS=


# 外部服务
# DeepSeek API Key
DEEPSEEK_API_KEY=


# 前端构建参数
# 前端请求后端的 API 基础地址
# 示例：https://api.washy.example.com
APP_API_BASE_URL=

# 编写好后在项目根下执行：docker compose -f ./docker-compose.yml -f ./docker-compose-production.yml up --build -d
# 停掉项目：docker compose -f docker-compose.yml -f docker-compose-production.yml down -v
